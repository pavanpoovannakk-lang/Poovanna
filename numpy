        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "# Sample data\n",
        "data = np.array([1, 2, 3, 4, 4, 4, 5, 6, 7, 8, 8, 9])\n",
        "\n",
        "print(f\"Original data: {data}\")\n",
        "\n",
        "# Calculate Mean\n",
        "mean_value = np.mean(data)\n",
        "print(f\"Mean: {mean_value:.2f}\")\n",
        "\n",
        "# Calculate Median\n",
        "median_value = np.median(data)\n",
        "print(f\"Median: {median_value:.2f}\")\n",
        "\n",
        "# Calculate Mode\n",
        "# NumPy does not have a direct function for mode, so we use scipy.stats.mode\n",
        "mode_result = stats.mode(data)\n",
        "\n",
        "# The mode_result returns an object with 'mode' and 'count' attributes, which are numpy arrays.\n",
        "# To get the scalar value from a 0-D or 1-D array, .item() is safer than [0].\n",
        "if mode_result.mode.size > 0:\n",
        "    print(f\"Mode: {mode_result.mode.item()} (Count: {mode_result.count.item()})\")\n",
        "else:\n",
        "    print(\"Mode: No unique mode found\")\n"
