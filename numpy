        "from transformers import pipeline\n",
        "\n",
        "# Load a pre-trained sentiment analysis model\n",
        "model_name = \"nlptown/bert-base-multilingual-uncased-sentiment\"\n",
        "\n",
        "# Initialize a sentiment analysis pipeline\n",
        "sentiment_pipeline = pipeline(\"sentiment-analysis\", model=model_name)\n",
        "\n",
        "# Define a mapping from 5-star labels to 3-category sentiment\n",
        "sentiment_mapping = {\n",
        "    '1 star': 'negative',\n",
        "    '2 stars': 'negative',\n",
        "    '3 stars': 'neutral',\n",
        "    '4 stars': 'positive',\n",
        "    '5 stars': 'positive'\n",
        "}\n",
        "\n",
        "for i in range(3):\n",
        "    input_sentence = input(f\"Please enter sentence {i+1} for sentiment analysis: \")\n",
        "\n",
        "    # The pipeline handles tokenization, model inference, and result decoding\n",
        "    result = sentiment_pipeline(input_sentence)\n",
        "\n",
        "    sentiment_label_5_stars = result[0]['label']\n",
        "    score = result[0]['score']\n",
        "\n",
        "    # Map the 5-star label to a 3-category sentiment\n",
        "    classified_sentiment = sentiment_mapping.get(sentiment_label_5_stars, 'unknown')\n",
        "\n",
        "    print(f\"The sentiment of sentence {i+1} is: {classified_sentiment} (original: {sentiment_label_5_stars}, score: {score:.2f})\")"
      ],
